@using DealDouble.Web.Code;
@model DealDouble.Web.ViewModels.CommentsViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@if (Model != null)
{
    <div class="row mt-2">
        <div class="col-lg-12 col-md-12">
            <h2>Comments</h2>
            <hr />
        </div>
        <div class="col-md-10">
            <form method="post" id="searchForm">
                <div class="input-group mb-3">
                    <input name="searchTerm" type="text" value="@Model.SearchTerm" class="form-control" placeholder="Search in Comments." required>
                    <button id="searchBtn" type="submit" class="form-control btn btn-primary"><i class="fas fa-search mr-1"></i> Search</button>
                    <a href="@Url.Action("Index", "Comments")" role="button" class="text-white form-control btn btn-primary dataLink"><i class="fas fa-redo-alt mr-1"></i> Reset</a>
                </div>
                <input type="hidden" name="page" value="1">
                <input type="hidden" name="items" value="10">
            </form>
        </div>
    </div>
    <hr />

    if (Model.Comments != null && Model.Comments.Count > 0)
    {
        foreach (var comment in Model.Comments)
        {
            var defaultStars = 5 - comment.Rating;

            var commentedAuction = Model.CommentedAuctions != null ? Model.CommentedAuctions.FirstOrDefault(x => x.ID == comment.RecordID) : null;

            <div class="row">
                <div class="col-md-2 text-center">
                    <img src="/Content/images/site/user-default-avatar.png" class="img rounded-circle img-fluid" style="height:105px; width:105px;">
                </div>
                <div class="col-md-9">
                    <p>
                        <a class="float-left" href="@Url.Action("UsersDetails", "Dashboard", new { userID = comment.UserID })">
                            <strong>
                                @comment.User.UserName
                            </strong>
                        </a>
                        <span class="float-right mb-2">
                            @comment.TimeStamp
                        </span>
                    </p>
                    <div class="clearfix"></div>
                    <p>
                        @comment.Text
                    </p>
                    <span class="text-warning">
                        @for (int i = 1; i <= comment.Rating; i++)
                        {
                            <i class="fas fa-star"></i>
                        }

                        @for (int i = 1; i <= defaultStars; i++)
                        {
                            <i class="far fa-star"></i>
                        }
                    </span>

                    @if (commentedAuction != null)
                    {
                        <span class="float-right">
                            <a href="@Url.Action("Details", "Auctions", new { ID = comment.RecordID, category = commentedAuction.Category.Name.ToLower().SanitizeString() })" target="_blank">
                                @commentedAuction.Title
                            </a>
                        </span>
                    }
                </div>
                <div class="col-md-1 text-center">
                    <button data-id="@comment.ID" class="btn btn-danger m-2 btnDeleteComment"><i class="fas fa-trash-alt mr-1"></i> Delete</button>
                </div>
            </div>
            <hr />
        }

        if (Model.Pager != null && Model.Pager.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">

                    @if (Model.Pager.CurrentPage == 1)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link dataLink" href="@Url.Action("Index", "Comments", new { pageNo = Model.Pager.CurrentPage - 1, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">Previous</a>
                        </li>
                    }

                    @for (int page = Model.Pager.StartPage; page < Model.Pager.EndPage + 1; page++)
                    {
                        var active = page == Model.Pager.CurrentPage ? "active" : string.Empty;

                        <li class="page-item @active">
                            <a class="page-link dataLink" href="@Url.Action("Index", "Comments", new { pageNo = page, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">
                                @page
                            </a>
                        </li>
                    }

                    @if (Model.Pager.CurrentPage == Model.Pager.EndPage)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link dataLink" href="@Url.Action("Index", "Comments", new { pageNo = Model.Pager.CurrentPage + 1, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            No comments found.
        </div>
    }

    <script>
        $(".btnDeleteComment").click(function () {
            swal({
				title: "Are you sure you want to delete this comment?",
				icon: "warning",
				buttons: true,
				dangerMode: true,
			})
			.then((willDelete) => {
				if (willDelete) {
					$("#dtLoader").show();
					$("#response-holder").hide();

					$.ajax({
						url: "@Url.Action("Delete", "Comments")",
                        method: "post",
                        data: { id : $(this).attr("data-id") }
					})
                        .done(function (response) {
                            if (response != null && response.Success != undefined && response.Success) {
							window.location.href = "@Url.Action("Index", "Comments")";
						}
						else {
							swal("Error!", "An error occured. Can't delete comment.", "error");
						}
					});
				}
			});
        });
    </script>
}
else
{
    <div class="alert alert-warning" role="alert">
        No comments data available.
    </div>
}