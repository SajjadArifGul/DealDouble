<div class="row mt-2">
	<div class="col-lg-3">
		<div class="card">
			<img src="~/Content/images/site/user-default-avatar.png" class="card-img-top" alt="...">
			<div class="card-body">
				<h5 class="card-title m-0">Sajjad Gul</h5>
			</div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item" title="Username">
					<i class="fas fa-user-alt mr-1"></i>
					Sajjad
				</li>
			</ul>
		</div>
	</div>
	<div class="col-lg-9">
		<div class="card">
			<div class="card-header">
				<ul class="nav nav-tabs card-header-tabs">
					<li class="nav-item">
						<a class="user-link nav-link active" data-href="@Url.Action("UsersDetails", "Manage")">Info</a>
					</li>
					<li class="nav-item">
						<a class="user-link nav-link" data-href="@Url.Action("ChangePassword", "Manage")">Change Password</a>
					</li>
					<li class="nav-item">
						<a class="user-link nav-link" data-href="@Url.Action("UsersBids", "Manage")">Bids</a>
					</li>
					<li class="nav-item">
						<a class="user-link nav-link" data-href="@Url.Action("UsersComments", "Manage")">Comments</a>
					</li>
				</ul>
			</div>
			<div class="card-body">
				<div class="d-flex justify-content-center">
					<div class="spinner-border m-5" role="status" id="dtLoader" style="display:none">
						<span class="sr-only">Loading...</span>
					</div>
				</div>
				<div id="response-holder">
					@{ Html.RenderAction("UsersDetails", "Manage"); }
				</div>
			</div>
		</div>
	</div>
</div>

<script>
        $(".user-link").click(function () {
            var url = $(this).attr("data-href");

            if (url != undefined && url != "") {
            	$("#dtLoader").show();
            	$("#response-holder").html("");

                $(".user-link").removeClass("active");
                $(this).addClass("active");

                $.ajax({
				    url: url,
			    })
			    .done(function (response) {
			    	$("#dtLoader").hide();
                    $("#response-holder").html(response);
			    });
            }
        });
</script>