@model DealDouble.Web.ViewModels.BidsListingViewModel

<table class="table table-hover">
    <thead class="thead-light">
        <tr>
            <th>
                Auction
            </th>
            <th>
                Bid By
            </th>
            <th>
                Date
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bids != null && Model.Bids.Count > 0)
        {
            foreach (var bid in Model.Bids)
            {
                <tr>
                    <td>
                        <a class="link" href="@Url.Action("Details", "Auctions", new { ID = bid.AuctionID, category = bid.Auction.Category.SanitizedName })" role="button" target="_blank">
                            @bid.Auction.Title
                        </a>
                    </td>
                    <td>
                        <a class="link" href="@Url.Action("UsersDetails", "Dashboard", new { userID = bid.UserID })" role="button" target="_blank">
                            @bid.User.FullName
                        </a>
                    </td>
                    <td>
                        @bid.Timestamp
                    </td>
                    <td>
                        <button class="deleteButton btn btn-danger" data-id="@bid.ID" data-toggle="modal" data-target="#deleteModal">
                            <i class="fas fa-trash-alt"></i>
                            Delete
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td class="text-center" colspan="5">
                    No Results Found.
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Pager != null && Model.Pager.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">

            @if (Model.Pager.CurrentPage == 1)
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", "Bids", new { UserID = Model.UserID, AuctionID = Model.AuctionID, pageNo = Model.Pager.CurrentPage - 1 })">Previous</a>
                </li>
            }

            @for (int page = Model.Pager.StartPage; page < Model.Pager.EndPage + 1; page++)
            {
                var active = page == Model.Pager.CurrentPage ? "active" : string.Empty;

                <li class="page-item @active">
                    <a class="page-link" href="@Url.Action("Index", "Bids", new { UserID = Model.UserID, AuctionID = Model.AuctionID, pageNo = page  })">
                        @page
                    </a>
                </li>
            }

            @if (Model.Pager.CurrentPage == Model.Pager.EndPage)
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#">Next</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", "Bids", new { UserID = Model.UserID, AuctionID = Model.AuctionID, pageNo = Model.Pager.CurrentPage + 1  })">Next</a>
                </li>
            }

        </ul>
    </nav>
}

<script>
    $(".deleteButton").click(function () {

        swal({
				title: "Are you sure you want to delete this bid?",
				icon: "warning",
				buttons: true,
				dangerMode: true,
			})
			.then((willDelete) => {
				if (willDelete) {
					$.ajax({
		            	url: "@Url.Action("Delete", "Bids")",
		            	method: "post",
		            	data: {
		            		ID: $(this).attr("data-id")
		            	}
                    }).done(function (response) {
                        if (response != null) {
                            if (response.Success) {
                                ReloadListing();
                            }
                            else {
                                swal("Error!", response.Message, "error");
                            }
                        }
                        else {
                            swal("Error!", "no response from server", "error");
                        }
                    });
				}
			});
	});
</script>