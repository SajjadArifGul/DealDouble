@model DealDouble.Web.ViewModels.BidsListingViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row mt-2">
    <div class="col-lg-12 col-md-12">
        <h2>Bids</h2>
        <hr />
    </div>
    <div class="col-md-10">
        <form method="get">
            <div class="input-group mb-3">
                <input name="UserID" type="text" value="@Model.UserID" class="form-control" placeholder="Search by User">
                <input name="AuctionID" type="text" value="@Model.AuctionID" class="form-control" placeholder="Search by Auction">

                <button type="submit" class="form-control btn btn-primary"><i class="fas fa-search"></i> Search</button>
                <a href="@Url.Action("Index", "Bids")" role="button" class="form-control btn btn-primary"><i class="fas fa-redo-alt"></i> Reset</a>
            </div>
            <input type="hidden" name="pageNo" value="1">
            <input type="hidden" name="items" value="10">
        </form>
    </div>
    <div class="col-lg-12" id="listingArea">
        @{Html.RenderAction("Listing", new { UserID = Model.UserID, AuctionID = Model.AuctionID, pageNo = Model.PageNo });}
    </div>
</div>

<script>
	function ReloadListing() {
		$.ajax({
			url: "@Url.Action("Listing", "Bids")",
			type: "get"
		}).done(function (response) {
			$("#listingArea").html(response);
		});
	}
</script>