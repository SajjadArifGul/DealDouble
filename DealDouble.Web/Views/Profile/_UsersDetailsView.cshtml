@model DealDouble.Web.ViewModels.ProfileDetailsViewModel

@if (Model != null && Model.User != null)
{
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">Full Name</label>
            <div class="col-sm-9">
                <input type="text" class="form-control" value="@Model.User.FullName" disabled readonly>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">Email</label>
            <div class="col-sm-9">
                <input type="email" class="form-control" value="@Model.User.Email" disabled readonly>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">Username</label>
            <div class="col-sm-9">
                <input type="text" class="form-control" value="@Model.User.UserName" disabled readonly>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">Country</label>
            <div class="col-sm-9">
                <input type="text" value="@Model.User.Country" class="form-control" disabled readonly>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">City</label>
            <div class="col-sm-9">
                <input type="text" value="@Model.User.City" class="form-control" disabled readonly>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label text-right">Address</label>
            <div class="col-sm-9">
                <textarea class="form-control" disabled readonly>@Model.User.Address</textarea>
            </div>
        </div>
}
