@model DealDouble.Web.ViewModels.AuctionsListingViewModel

<div class="row">
    <div id="auctionsList" class="col-lg-12">
        @if (Model.Auctions != null && Model.Auctions.Count > 0)
		{
			for (int i = 1; i <= Model.Auctions.Count; i++)
			{
				i--;
				var groupItem = 0;
				var classes = i == 0 ? "border-top-0 rounded-0" : string.Empty;

                <div class="card-group mb-4">
                    @foreach (var auction in Model.Auctions.Skip(i).Take(3))
					{
						groupItem++;
						var picURL = auction.AuctionPictures != null && auction.AuctionPictures.Count > 0 ?
										 "/Content/images/" + auction.AuctionPictures.First().Picture.URL : "http://placehold.it/700x400";

                        <div class="card @classes" relf-item="@groupItem">
                            <a href="@Url.Action("Details", "Auctions", new { ID = auction.ID })">
                                <img class="card-img-top" src="@picURL" alt="@auction.Title" style="height:300px;">
                            </a>
                            <hr />
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="@Url.Action("Details", "Auctions", new { ID = auction.ID })">@auction.Title</a>
                                </h5>
                                <p class="card-text">
                                    @(!string.IsNullOrEmpty(auction.Summary) && auction.Summary.Length >= 200 ? auction.Summary.Substring(0, 200) : auction.Summary)
                                </p>
                            </div>
                            <ul class="list-group list-group-flush ">
                                <li class="list-group-item border-bottom-0">
                                    <i class="fas fa-tags mr-1"></i>
                                    <a href="@Url.Action("Index", "Home", new { categoryID = auction.CategoryID })" class="card-link">
                                        @auction.Category.Name
                                    </a>
                                </li>
                            </ul>
                            <div class="card-footer">
                                <span class="text-muted float-left">
                                    <i class="fas fa-money-bill mr-1"></i>
                                    $@auction.ActualAmount
                                </span>
                                <button data-id="@auction.ID" type="button" class="btnBidNow btn btn-primary btn-sm float-right">
                                    <i class="fas fa-hand-holding-usd mr-1"></i>
                                    Bid Now
                                </button>
                            </div>
                        </div>

                        i++;
                    }

					@for (int cardItem = groupItem; cardItem < 3; cardItem++)
					{
						<div class="card @classes" relf-item="@groupItem">
						</div>
					}
                </div>
            }

            if (Model.Pager != null && Model.Pager.TotalPages > 1)
            {
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">

                        @if (Model.Pager.CurrentPage == 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link disabled" data-page="1">Previous</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <span class="page-link" data-page="@(Model.Pager.CurrentPage - 1)">Previous</span>
                            </li>
                        }

                        @for (int page = Model.Pager.StartPage; page < Model.Pager.EndPage + 1; page++)
                        {
                            var active = page == Model.Pager.CurrentPage ? "active" : string.Empty;

                            <li class="page-item @active">
                                <span class="page-link" data-page="@(page)">
                                    @page
                                </span>
                            </li>
                        }

                        @if (Model.Pager.CurrentPage == Model.Pager.EndPage)
                        {
                            <li class="page-item disabled">
                                <span class="page-link disabled" data-page="1">Next</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <span class="page-link" data-page="@(Model.Pager.CurrentPage + 1)">Next</span>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="border-top-0 rounded-0 p-2 border">
                <div class="alert alert-warning m-0" role="alert">
                    Sorry. No Auctions available.
                </div>
            </div>
        }
    </div>
	<div id="loadingList" class="col-lg-12" style="display:none">
		<div class="border-top-0 rounded-0 p-2 border">
			<div class="alert alert-primary m-0" role="alert">
				Loading...
			</div>
		</div>
	</div>
</div>

<script>
    $(".page-link").click(function () {
    	if (!$(this).hasClass("disabled")) {
            searchAuctions($("#sltCategories").val(), $("#txtSearchTerm").val(), $(this).attr("data-page"));
        }
    });
</script>