@model List<DealDouble.Entities.Auction>

<div id="listingArea">
	<table>
		<thead>
			<tr>
				<th>
					Title
				</th>
				<th>
					Description
				</th>
				<th>
					Actual Amount
				</th>
				<th>
					Starting Time
				</th>
				<th>
					Ending Time
				</th>
				<th>
					Actions
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var auction in Model)
			{
				<tr>
					<td>
						<input type="hidden" value="@auction.ID" />
						@auction.Title
					</td>
					<td>
						@auction.Description
					</td>
					<td>
						@auction.ActualAmount
					</td>
					<td>
						@auction.StartingTime
					</td>
					<td>
						@auction.EndingTime
					</td>
					<td>
						<button class="editButton" data-id="@auction.ID">Edit</button>
						<button class="deleteButton" data-id="@auction.ID">Delete</button>
					</td>
				</tr>
			}
		</tbody>
	</table>

	<div>
		<button id="createButton">Create New Auction</button>
	</div>

	<div id="contentArea">
	</div>

	<script>
	$("#createButton").click(function () {
		$.ajax({
			url: "Auctions/Create/",
			method: "get"
		}).done(function (response) {
			debugger;

			$("#contentArea").html(response);
		});
	});

	$(".editButton").click(function () {
		debugger;

		$.ajax({
			url: "Auctions/Edit/",
			method: "get",
			data: {
				ID: $(this).attr("data-id")
			}
		}).done(function (response) {
			debugger;

			$("#contentArea").html(response);
		});
	});

	$(".deleteButton").click(function () {
		debugger;

		var result = confirm("Are you sure you want to delete this Auction?");

		debugger;

		if (result == true)
		{
			$.ajax({
				url: "Auctions/Delete/",
				method: "post",
				data: {
					ID: $(this).attr("data-id")
				}
			})
			.done(function (response) {
				debugger;
				$("#listingArea").html(response);
			});
		}		
	});
	</script>
</div>