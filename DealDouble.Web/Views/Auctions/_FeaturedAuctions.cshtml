@using DealDouble.Web.Code;
@model DealDouble.Web.ViewModels.FeaturedAuctionsViewModel

<div class="">
    <div id="auctionsList" class="">
        @if (Model.Auctions != null && Model.Auctions.Count > 0)
        {
            foreach (var auction in Model.Auctions)
            {
                var picURL = auction.AuctionPictures != null && auction.AuctionPictures.Count > 0 ?
                                 "/Content/images/" + auction.AuctionPictures.First().Picture.URL : "http://placehold.it/700x400";

                <div class="card mb-2">
                    <a href="@Url.Action("Details", "Auctions", new { category = auction.Category.Name.ToLower().SanitizeString(), ID = auction.ID })">
                        <img class="card-img-top" src="@picURL" alt="@auction.Title" style="height:300px;">
                    </a>
                    <hr />
                    <div class="card-body py-0">
                        <h5 class="card-title">
                            <span class="badge badge-success text-white mr-1">Featured</span>
                            <a href="@Url.Action("Details", "Auctions", new { category = auction.Category.Name.ToLower().SanitizeString(), ID = auction.ID })">@auction.Title</a>
                        </h5>
                    </div>
                    <div class="card-footer">
                        <span class="text-muted float-left">
                            <i class="fas fa-money-bill mr-1"></i>
                            $@auction.ActualAmount
                        </span>
                        <button data-id="@auction.ID" type="button" class="btnBidNow btn btn-primary btn-sm float-right">
                            <i class="fas fa-hand-holding-usd mr-1"></i>
                            Bid Now
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>