@model DealDouble.Web.ViewModels.AuctionDetailsViewModel

@{
	var haveComments = Model.Comments != null && Model.Comments.Count > 0;

	var defaultRating = 5;
	var auctionRating = haveComments ? Math.Ceiling(Model.Comments.Average(x => x.Rating)) : 0;
}

<div class="row">
	<div class="col-lg-12">
		<div class="card">

			@if (Model.Auction.AuctionPictures != null && Model.Auction.AuctionPictures.Count > 0)
			{
				var i = 0;
				var firstAuctionPicture = Model.Auction.AuctionPictures.First();

				<div id="carouselIndicators" class="carousel slide" data-ride="carousel">
					<ol class="carousel-indicators">
						@foreach (var picture in Model.Auction.AuctionPictures)
						{
							var active = picture == firstAuctionPicture ? "active" : string.Empty;

							<li class="@active" data-target="#carouselIndicators" data-slide-to="@i"></li>

							i++;
						}
					</ol>
					<div class="carousel-inner" role="listbox">
						@foreach (var auctionPicture in Model.Auction.AuctionPictures)
						{
							var active = auctionPicture == firstAuctionPicture ? "active" : string.Empty;

							var picURL = "/Content/images/" + auctionPicture.Picture.URL;

							<div class="carousel-item @active text-center">
								<img class="img-fluid" src="@picURL">
							</div>
						}
					</div>
					<a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
			}

			<div class="card-body">
				<h3 class="card-title">@Model.Auction.Title</h3>
				<hr />
				<h5>
					<span class="float-left">
						Actual Amount: $@Model.Auction.ActualAmount
					</span>
					@if (Model.LatestBidder != null)
					{
						<span class="float-right">
							Bid Amount: $@Model.BidsAmount
						</span>
					}
				</h5>
				<div class="clearfix"></div>
				<hr />
				<p class="card-text text-justify">
                    @Html.Raw(Model.Auction.Description)
                </p>
			</div>
			<div class="card-footer text-muted">
				<button type="button" class="btn btn-primary" id="btnBidNow">Bid Now</button>

				<span class="text-warning float-right align-middle">
					@for (int i = 1; i <= auctionRating; i++)
					{
						<i class="fas fa-star"></i>
					}

					@for (int i = 1; i <= defaultRating - auctionRating; i++)
					{
						<i class="far fa-star"></i>
					}
				</span>

			</div>
		</div>

		@{ Html.RenderPartial("_Comments"); }
	</div>

    <div class="col-lg-4">
        
    </div>
</div>

<script>
	$("#btnBidNow").click(function () {
		$.ajax({
			url: "@Url.Action("Bid", "Bids")",
			type: "post",
			data: {
				ID: '@Model.Auction.ID'
			}
		})
		.done(function (response) {
			if (response.Success) {
				window.location.reload();
			}
			else {
				swal("Error!", response.Message, "error");
			}
		})
		.fail(function () {
			swal("Error!", "Error Occured. Please try again later.", "error");
		});
	});
</script>