					</a>
				</li>
                @if (User.Identity.IsAuthenticated)
                {
                    if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item p-2">
                            <a class="nav-link" href="@Url.Action("Index", "Dashboard")">
                                <i class="fas fa-user-shield m-1"></i>
                                Dashboard
                            </a>
                        </li>
                    }

                    <li class="nav-item p-2 ">
                        <a id="btnLogOff" class="nav-link" href="#">
