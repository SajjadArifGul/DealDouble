@using Microsoft.AspNet.Identity
<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            @*<img src="~/Content/images/site/deal-double-logo-svg.svg" width="30" height="30" class="d-inline-block align-top" alt="">*@
            <i class="fas fa-check-double mr-1"></i>
            Deal Double
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item p-2">
                    <a class="nav-link" href="@Url.Action("Search", "Home")">
                        <i class="fab fa-shirtsinbulk m-1"></i>
                        Auctions
                    </a>
                </li>
                
                @{ Html.RenderAction("FeaturedCategories", "Categories"); }
                <li class="nav-item p-2">
                    <a class="nav-link" href="@Url.Action("Index", "Help")">
                        <i class="fas fa-hands-helping"></i>
                        Help
                    </a>
                </li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            @Html.UserAvatar(new DealDouble.Entities.Picture(), "image rounded-circle", style: "width: 40px; height: 40px", alt: string.Format("Hi {0}!", User.Identity.GetUserName()))
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <a class="dropdown-item" href="@Url.Action("Index", "Profile")">
                                <i class="fas fa-user-cog m-1"></i>
                                Profile
                            </a>
                            @if (User.IsInRole("Administrator"))
                            {
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("Index", "Dashboard")">
                                    <i class="fas fa-user-shield m-1"></i>
                                    Dashboard
                                </a>
                            }
                            <a id="btnLogOff" class="dropdown-item" href="#">
                                <i class="fas fa-sign-out-alt m-1"></i>
                                LogOff
                            </a>
                        </div>
                    </li>
                }
                else
                {
                    <li class="nav-item p-2">
                        <a class="nav-link" href="@Url.Action("Login", "Account")">
                            <i class="fas fa-sign-in-alt m-1"></i>
                            Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<form id="logOffForm" method="post" action="@Url.Action("LogOff", "Account")">
    @Html.AntiForgeryToken()
</form>

<script>
    $("#btnLogOff").click(function () {
        $("#logOffForm").submit();
    });
</script>