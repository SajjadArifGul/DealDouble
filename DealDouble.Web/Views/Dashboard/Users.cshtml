@model DealDouble.Web.ViewModels.UsersViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row mt-2">
    <div class="col-lg-12 col-md-12">
        <h2>Users</h2>
        <hr />
    </div>
    <div class="col-md-10">
        <form method="post">
            <div class="input-group mb-3">
                <input name="userSearch" type="text" value="@Model.UserSearch" class="form-control" placeholder="Search">
                <button type="submit" class="form-control btn btn-primary"><i class="fas fa-search"></i> Search</button>
                <a href="@Url.Action("Users", "Dashboard")" role="button" class="form-control btn btn-primary"><i class="fas fa-redo-alt"></i> Reset</a>
            </div>
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="items" value="10">
        </form>
    </div>
    <div class="col-lg-12" id="listingArea">
        @{Html.RenderPartial("_UserListing", Model);}
    </div>
</div>


<div class="modal fade" id="formModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="contentArea">
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Are you sure you want to delete this record?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" id="mDeleteButton">Delete</button>
            </div>
        </div>
    </div>
</div>

<div id="imageTemplate" style="display:none">
    <img class='image img-thumbnail' src='' style="width: 200px; height: 200px;" />
</div>

<script>
	$("#createButton").click(function () {
		$.ajax({
			url: "@Url.Action("Create", "Auctions")",
			type: "get"
        }).done(function (response) {
            $("#contentArea").html(response);
			$('#formModal').modal('toggle');
		});
	});


	$("#mDeleteButton").click(function () {
		$.ajax({
			url: "@Url.Action("Delete", "Auctions")",
			type: "post",
			data: {
				ID: $(this).attr("data-recordID")
			}
		})
		.done(function (response) {
			$("#listingArea").html(response);
			$('#deleteModal').modal('toggle');
		});
	});

	function AttachNewImage(imageURL, imageID) {
		var $newimgHTML = $("#imageTemplate").clone();

		$newimgHTML.find(".image").attr("src", "/content/images/" + imageURL);
		$newimgHTML.find(".image").attr("data-id", imageID);

		$("#picturesArea").append($newimgHTML.html());

		RemoveImagesOnClick();
	}

	function RemoveImagesOnClick() {
		$("#picturesArea .image").click(function () {
			$(this).remove();
		});
	}

	function ReloadListing() {
		$.ajax({
			url: "@Url.Action("Listing", "Auctions")",
			type: "get"
		}).done(function (response) {
			$("#listingArea").html(response);
		});
	}

</script>
