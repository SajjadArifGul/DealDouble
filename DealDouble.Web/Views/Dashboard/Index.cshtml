@model DealDouble.Web.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="jumbotron jumbotron-fluid my-0">
	<div class="container">
		<h1 class="display-4">Hello, @User.Identity.Name!</h1>
		<p class="lead">
			Welcome to Deal Double Dashboard. Below are a few demographics of Deal Double.
		</p>
	</div>
</div>

<div class="card-deck text-primary mt-4">
    <div class="card text-center ">
        <h1 class="card-title display-2 align-middle">
            @Model.AuctionsCount
        </h1>
        <div class="card-footer display-4">
            <a href="@Url.Action("Index", "Auctions")">Auctions</a>
        </div>
    </div>

    <div class="card text-center ">
        <h1 class="card-title display-2 align-middle">
            @Model.BidsCount
        </h1>
        <div class="card-footer display-4">
            <a href="@Url.Action("Index", "Bids")">Bids</a>
        </div>
    </div>
	<div class="card text-center ">
		<h1 class="card-title display-2 align-middle">
			@Model.CommentsCount
		</h1>
		<div class="card-footer display-4">
			<a href="@Url.Action("Comments", "Dashboard")">Comments</a>
		</div>
	</div>

</div>
<div class="card-deck text-primary my-4">
	<div class="card text-center ">
		<h1 class="card-title display-2 align-middle">
			@Model.UserCount
		</h1>
		<div class="card-footer display-4">
			<a href="@Url.Action("Users", "Dashboard")">Users</a>
		</div>
	</div>

	<div class="card text-center ">
		<h1 class="card-title display-2 align-middle">
			@Model.RolesCount
		</h1>
		<div class="card-footer display-4">
			<a href="@Url.Action("Roles", "Dashboard")">Roles</a>
		</div>
	</div>

	<div class="card text-center ">
		<h1 class="card-title display-2 align-middle">
			@Model.CategoriesCount
		</h1>
		<div class="card-footer display-4">
			<a href="@Url.Action("Index", "Categories")">Categories</a>
		</div>
	</div>
</div>