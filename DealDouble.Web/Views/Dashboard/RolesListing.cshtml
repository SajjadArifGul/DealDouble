@model DealDouble.Web.ViewModels.RolesListingViewModel

<table class="table table-hover">
    <thead class="bg-secondary text-white">
        <tr>
            <th>
                ID
            </th>
            <th>
                Role
            </th>
            <th>
                Users
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Roles != null && Model.Roles.Count > 0)
        {
            foreach (var role in Model.Roles)
            {
                <tr>
                    <td>
                        @role.Id
                    </td>
                    <td>
                        @role.Name
                    </td>
                    <td>
                        @role.Users.Count
                    </td>
                    <td>
                        <button class="moreButton btn btn-primary" data-id="@role.Id">
                            <i class="fas fa-edit"></i>
                            More Details
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td class="text-center" colspan="7">
                    No Results Found.
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Pager != null && Model.Pager.TotalPages > 1)
{
    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">

            @if (Model.Pager.CurrentPage == 1)
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Roles", "Dashboard", new { pageNo = Model.Pager.CurrentPage - 1, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">Previous</a>
                </li>
            }

            @for (int page = Model.Pager.StartPage; page < Model.Pager.EndPage + 1; page++)
            {
                var active = page == Model.Pager.CurrentPage ? "active" : string.Empty;

                <li class="page-item @active">
                    <a class="page-link" href="@Url.Action("Roles", "Dashboard", new { pageNo = page, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">
                        @page
                    </a>
                </li>
            }

            @if (Model.Pager.CurrentPage == Model.Pager.EndPage)
            {
                <li class="page-item disabled">
                    <a class="page-link" href="#">Next</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Roles", "Dashboard", new { pageNo = Model.Pager.CurrentPage + 1, searchTerm = !string.IsNullOrEmpty(Model.SearchTerm) ? Model.SearchTerm : null })">Next</a>
                </li>
            }

        </ul>
    </nav>
}

