@model DealDouble.Web.ViewModels.RolesViewModel
@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}


<div class="row mt-2">
    <div class="col-lg-12 col-md-12">
        <h2>Roles</h2>
        <hr />
    </div>
    <div class="col-md-10">
        <form method="post">
            <div class="input-group mb-3">
                <input name="searchTerm" type="text" value="@Model.SearchTerm" class="form-control" placeholder="Search with Role Name.">
                <button type="submit" class="form-control btn btn-primary"><i class="fas fa-search mr-1"></i> Search</button>
                <a href="@Url.Action("Roles", "Dashboard")" role="button" class="form-control btn btn-primary"><i class="fas fa-redo-alt mr-1"></i> Reset</a>
                <button type="button" class="form-control btn btn-success" data-toggle="modal" data-target="#formModal"><i class="fas fa-plus"></i> Create Role</button>
            </div>
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="items" value="10">
        </form>
    </div>
    <div class="col-lg-12" id="listingArea">
        @{Html.RenderAction("RolesListing", new { searchTerm = Model.SearchTerm, pageNo = Model.PageNo });}
    </div>
</div>

<div class="modal fade" id="formModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="contentArea">
            <div class="modal-header">
                <h5 class="modal-title">Create New Role</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="role-form">
                <div class="modal-body">
                    <div class="form-group">
                        <label>
                            Name
                        </label>
                        <input id="newRoleName" class="form-control" name="Name" value="" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button class="btn btn-success" type="button" id="saveButton">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $("#saveButton").click(function () {

        var name = $("#newRoleName").val();

        if (name != undefined && name != "") {
            $("#dtLoader").show();
            $("#response-holder").hide();

            $.ajax({
                url: "@Url.Action("CreateRole", "Dashboard")",
                method: "post",
                data: { roleName: name }
            })
            .done(function (response) {
                $("#dtLoader").hide();
                $("#response-holder").show();

                if (response.Success) {
                    location.reload();
                }
                else {
                    swal("Error!", response.Message, "error");
                }
            });
        }
        else {
            swal("Warning!", "Please add a valid Role Name.", "warning");
        }
    });

    $("#role-form").submit(function (event) { event.preventDefault(); });
</script>