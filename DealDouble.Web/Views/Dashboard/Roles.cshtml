@model DealDouble.Web.ViewModels.RolesViewModel
@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}


<div class="row mt-2">
    <div class="col-lg-12 col-md-12">
        <h2>Roles</h2>
        <hr />
    </div>
    <div class="col-md-10">
        <form method="post">
            <div class="input-group mb-3">
                <input name="searchTerm" type="text" value="@Model.SearchTerm" class="form-control" placeholder="Search with Role Name.">
                <button type="submit" class="form-control btn btn-primary"><i class="fas fa-search mr-1"></i> Search</button>
                <a href="@Url.Action("Roles", "Dashboard")" role="button" class="form-control btn btn-primary"><i class="fas fa-redo-alt mr-1"></i> Reset</a>
				<button type="button" class="form-control btn btn-success" id="createButton"><i class="fas fa-plus"></i> Create Role</button>
            </div>
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="items" value="10">
        </form>
    </div>
    <div class="col-lg-12" id="listingArea">
        @{Html.RenderAction("RolesListing", new { searchTerm = Model.SearchTerm, pageNo = Model.PageNo });}
    </div>
</div>

<div class="modal fade" id="formModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content" id="contentArea">
		</div>
	</div>
</div>

<script>
	$("#createButton").click(function () {
		$.ajax({
			url: "@Url.Action("CreateRole", "Dashboard")",
			type: "get"
		}).done(function (response) {
			$("#contentArea").html(response);
			$('#formModal').modal('toggle');
		});
	});
</script>