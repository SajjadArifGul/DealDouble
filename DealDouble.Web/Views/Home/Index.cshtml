@model DealDouble.Web.ViewModels.AuctionsViewModel

<div class="row">
	<div class="col-lg-12">

		<div id="carouselExampleIndicators" class="carousel slide my-4" data-ride="carousel">
			<ol class="carousel-indicators">
				<li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
				<li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
				<li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
			</ol>
			<div class="carousel-inner" role="listbox">
				<div class="carousel-item active">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="First slide">
				</div>
				<div class="carousel-item">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="Second slide">
				</div>
				<div class="carousel-item">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="Third slide">
				</div>
			</div>
			<a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="sr-only">Previous</span>
			</a>
			<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="sr-only">Next</span>
			</a>
		</div>
		<div class="row">
			<div class="col-lg-12">
				<div class="border p-2">
					<div class="float-left">
						<select id="sltCategories" class="form-control">
							<option value="0" selected>Browse Categories</option>
                            @if (Model.Categories != null)
                            {
                                foreach (var category in Model.Categories)
                                {
							        <option value="@category.ID">@category.Name</option>
                                }
                            }                            
						</select>
					</div>
					<div class="float-right">
						<form class="form-inline">
							<input id="txtSearchTerm" class="form-control mr-sm-2" type="search" placeholder="Search" aria-label="Search">
							<button id="btnSearchTerm" class="btn btn-outline-success my-2 my-sm-0" type="button">Search</button>
						</form>
					</div>
					<div class="clearfix"></div>
				</div>
			</div>
		</div>
        <div id="auctionsArea">
            @{ Html.RenderAction("SearchAuctions", "Auctions"); }
        </div>
	</div>
</div>

<script>
	var bidTimer;
	var i = 0;

	$(document).ready(function () {
		//bidTimer = setInterval(updateBids, 3000);
    });

    $("#btnSearchTerm").click(function () {
        searchAuctions($("#sltCategories").val(), $("#txtSearchTerm").val());
    });

    $("#sltCategories").change(function () {
        searchAuctions($(this).val());
    });

    function searchAuctions(categoryID, searchTerm, pageNo) {
        $.ajax({
			url: "@Url.Action("SearchAuctions", "Auctions")",
			method: "post",
			data: {
                categoryID: categoryID,
                searchTerm: searchTerm,
                pageNo: pageNo
			}
        }).done(function (response) {
            $("#auctionsArea").html(response);
		});
    }

	function updateBids() {
		$.ajax({
			url: "@Url.Action("UpdateAuctions", "Auctions")",
			method: "get",
			data: {
				AuctionIDs: '@string.Join(",", Model.PromotedAuctions.Select(x=>x.ID).ToList())'
			}
		}).done(function (response) {
			$.each(response, function (key, value) {
				i++;
				console.log(key, value);

				$(".bidAmount", "[data-id = " + value.ID + "]").html(value.BidAmount + '' + i);
			});
		});
	}

	$(".btnBidNow").click(function () {
		$.ajax({
			url: "@Url.Action("Bid", "Bids")",
			type: "post",
			data: {
				ID: $(this).attr("data-id")
			}
		})
		.done(function (response) {
			if (response.Success) {
				window.location.reload();
			}
			else {
				swal("Error!", response.Message, "error");
			}
		})
		.fail(function () {
			swal("Error!", "Error Occured. Please try again later.", "error");
		});
	});
</script>