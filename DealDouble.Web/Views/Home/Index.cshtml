@model DealDouble.Web.ViewModels.PageViewModel

@{ Html.RenderAction("HomeSliders", "Home"); }

<div id="auctionsArea">
    @{ Html.RenderAction("Search", "Home", new { isPartial = true }); }
</div>

<script>
	var bidTimer;
	var i = 0;

	$(document).ready(function () {
		//bidTimer = setInterval(updateBids, 3000);
    });

    $("#btnSearchTerm").click(function () {
        searchAuctions($("#sltCategories").val(), $("#txtSearchTerm").val());
    });

    $("#sltCategories").change(function () {
    	$("#txtSearchTerm").val("");
        searchAuctions($(this).val());
    });

    function searchAuctions(categoryID, searchTerm, pageNo) {
    	$("#auctionsList").hide();
    	$("#loadingList").show();

        $.ajax({
			url: "@Url.Action("SearchAuctions", "Auctions")",
			method: "post",
			data: {
                categoryID: categoryID,
                searchTerm: searchTerm,
                pageNo: pageNo
			}
        }).done(function (response) {
            $("#auctionsArea").html(response);
		});
    }

	@*function updateBids() {
		$.ajax({
			url: "@Url.Action("UpdateAuctions", "Auctions")",
			method: "get",
			data: {
				AuctionIDs: '@string.Join(",", Model.PromotedAuctions.Select(x=>x.ID).ToList())'
			}
		}).done(function (response) {
			$.each(response, function (key, value) {
				i++;
				console.log(key, value);

				$(".bidAmount", "[data-id = " + value.ID + "]").html(value.BidAmount + '' + i);
			});
		});
	}*@

	$(".btnBidNow").click(function () {
		$.ajax({
			url: "@Url.Action("Bid", "Bids")",
			type: "post",
			data: {
				ID: $(this).attr("data-id")
			}
		})
		.done(function (response) {
			if (response.Success) {
				window.location.reload();
			}
			else {
				swal("Error!", response.Message, "error");
			}
		})
		.fail(function () {
			swal("Error!", "Error Occured. Please try again later.", "error");
		});
	});
</script>