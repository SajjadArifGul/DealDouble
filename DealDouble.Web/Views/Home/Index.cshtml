@model DealDouble.Web.ViewModels.AuctionsViewModel

<div class="row">
	<div class="col-lg-12">

		<div id="carouselExampleIndicators" class="carousel slide my-4" data-ride="carousel">
			<ol class="carousel-indicators">
				<li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
				<li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
				<li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
			</ol>
			<div class="carousel-inner" role="listbox">
				<div class="carousel-item active">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="First slide">
				</div>
				<div class="carousel-item">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="Second slide">
				</div>
				<div class="carousel-item">
					<img class="d-block img-fluid" src="http://placehold.it/1110x350" alt="Third slide">
				</div>
			</div>
			<a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="sr-only">Previous</span>
			</a>
			<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="sr-only">Next</span>
			</a>
		</div>
		<div class="row">
			<div class="col-lg-12">
				<div class="border p-2">
					<div class="float-left">
						<select class="form-control">
							<option selected>Browse Categories</option>
							<option value="1">One</option>
							<option value="2">Two</option>
							<option value="3">Three</option>
						</select>
					</div>
					<div class="float-right">
						<form class="form-inline">
							<input class="form-control mr-sm-2" type="search" placeholder="Search" aria-label="Search">
							<button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
						</form>
					</div>
					<div class="clearfix"></div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-lg-12">
				@if (Model.AllAuctions != null && Model.AllAuctions.Count > 0)
				{
					for (int i = 1; i <= Model.AllAuctions.Count; i++)
					{
						i--;

						var classes = i == 0 ? "border-top-0 rounded-0" : string.Empty;

						<div class="card-group mb-4">
							@foreach (var auction in Model.AllAuctions.Skip(i).Take(3))
							{
								var picURL = auction.AuctionPictures != null && auction.AuctionPictures.Count > 0 ?
												 "/Content/images/" + auction.AuctionPictures.First().Picture.URL : "http://placehold.it/700x400";

								<div class="card @classes">
									<a href="@Url.Action("Details", "Auctions", new { ID = auction.ID })">
										<img class="card-img-top" src="@picURL" alt="@auction.Title" style="height:300px;">
									</a>
									<hr />
									<div class="card-body">
										<h5 class="card-title">
											<a href="@Url.Action("Details", "Auctions", new { ID = auction.ID })">@auction.Title</a>
										</h5>
										<p class="card-text">
											@(!string.IsNullOrEmpty(auction.Summary) && auction.Summary.Length >= 200 ? auction.Summary.Substring(0, 200) : auction.Summary)
										</p>
									</div>
									<ul class="list-group list-group-flush ">
										<li class="list-group-item border-bottom-0">
											<i class="fas fa-tags mr-1"></i>
											<a href="@Url.Action("Index", "Auctions", new { categoryID = auction.CategoryID })" class="card-link">
												@auction.Category.Name
											</a>
										</li>
									</ul>
									<div class="card-footer">
										<span class="text-muted float-left">
											<i class="fas fa-money-bill mr-1"></i>
											$@auction.ActualAmount
										</span>
										<button data-id="@auction.ID" type="button" class="btnBidNow btn btn-primary btn-sm float-right" id="btnBidNow">
											<i class="fas fa-hand-holding-usd mr-1"></i>
											Bid Now
										</button>
									</div>
								</div>

								i++;
							}
						</div>
					}
				}
			</div>
		</div>
	</div>
</div>

<script>
	var bidTimer;
	var i = 0;

	$(document).ready(function () {
		bidTimer = setInterval(updateBids, 3000);
	});

	function updateBids() {
		$.ajax({
			url: "@Url.Action("UpdateAuctions", "Auctions")",
			method: "get",
			data: {
				AuctionIDs: '@string.Join(",", Model.PromotedAuctions.Select(x=>x.ID).ToList())'
			}
		}).done(function (response) {
			$.each(response, function (key, value) {
				i++;
				console.log(key, value);

				$(".bidAmount", "[data-id = " + value.ID + "]").html(value.BidAmount + '' + i);
			});
		});
	}

	$(".btnBidNow").click(function () {
		$.ajax({
			url: "@Url.Action("Bid", "Bids")",
			type: "post",
			data: {
				ID: $(this).attr("data-id")
			}
		})
		.done(function (response) {
			if (response.Success) {
				window.location.reload();
			}
			else {
				swal("Error!", response.Message, "error");
			}
		})
		.fail(function () {
			swal("Error!", "Error Occured. Please try again later.", "error");
		});
	});
</script>