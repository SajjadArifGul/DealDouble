
@model List<DealDouble.Entities.Category>

@if (Model != null && Model.Count > 0)
{
    <li class="nav-item p-2 dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="categoriesDropDown" role="button" data-toggle="dropdown">
            <i class="fas fa-sitemap m-1"></i>
            Categories
        </a>
        <div class="dropdown-menu">
            @foreach (var category in Model)
            {
                <a class="dropdown-item" href="@Url.Action("Search", "Home", new { categoryID = category.ID })">
                    @category.Name
                </a>
            }
        </div>
    </li>
}