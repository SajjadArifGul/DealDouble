@model DealDouble.Web.ViewModels.CategoriesListingViewModel
@{ 
	Layout = "~/Views/Shared/_DashboardLayout.cshtml";
	var categoryID = Model.ParentCategoryID.HasValue ? Model.ParentCategoryID.Value : 0;
}

<div class="row mt-2">
	<div class="col-lg-12 col-md-12">
		<h2>Categories</h2>
		<hr />
	</div>
	<div class="col-md-10">
		<form method="post">
			<div class="input-group mb-3">
				<input name="searchTerm" type="text" value="@Model.SearchTerm" class="form-control" placeholder="Search">
				<select class="form-control custom-select" name="parentCategoryID">
					<option value="0">Select Category...</option>
					@foreach (var category in Model.ParentCategories)
					{
						var selected = category.ID == categoryID ? "selected" : string.Empty;
						<option value="@category.ID" @selected>@category.Name</option>
					}
				</select>

				<button type="submit" class="form-control btn btn-primary"><i class="fas fa-search"></i> Search</button>
				<a href="@Url.Action("Index", "Categories")" role="button" class="form-control btn btn-primary"><i class="fas fa-redo-alt"></i> Reset</a>
				<button type="button" class="form-control btn btn-success" id="createButton"><i class="fas fa-plus"></i> Create Category</button>				
			</div>
			<input type="hidden" name="page" value="1">
			<input type="hidden" name="items" value="10">
		</form>
	</div>
	<div class="col-lg-12" id="listingArea">
		@{Html.RenderAction("Listing", new { parentCategoryID = Model.ParentCategoryID, searchTerm = Model.SearchTerm, pageNo = Model.PageNo });}
	</div>
</div>

<div class="modal fade" id="formModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content" id="contentArea">
		</div>
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Are you sure you want to delete this record?</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-danger" id="mDeleteButton">Delete</button>
			</div>
		</div>
	</div>
</div>

<script>
	$("#createButton").click(function () {
		$.ajax({
			url: "@Url.Action("Create", "Categories")",
			type: "get"
		}).done(function (response) {
			$("#contentArea").html(response);
			$('#formModal').modal('toggle');
		});
	});
	
	$("#mDeleteButton").click(function () {
		$.ajax({
			url: "@Url.Action("Delete", "Categories")",
			type: "post",
			data: {
				ID: $(this).attr("data-recordID")
			}
		})
		.done(function (response) {
			$("#listingArea").html(response);
			$('#deleteModal').modal('toggle');
		});
	});
	
	function ReloadListing() {
		$.ajax({
			url: "@Url.Action("Listing", "Auctions")",
			type: "get"
		}).done(function (response) {
			$("#listingArea").html(response);
		});
	}

</script>