@model DealDouble.Web.ViewModels.CategoryViewModel

<div class="modal-header">
	<h5 class="modal-title">Create Category</h5>
	<button type="button" class="close" data-dismiss="modal" aria-label="Close">
		<span aria-hidden="true">&times;</span>
	</button>
</div>
<form id="createForm" method="post">
	<div class="modal-body">
		<div class="form-group">
			<label>
				Parent Category
			</label>
			<select class="form-control" name="ParentCategoryID">
				<option value="0">- None -</option>
				@foreach (var category in Model.Categories)
				{
					var selected = Model.ParentCategoryID == category.ID ? "selected" : string.Empty;
					<option value="@category.ID" @selected>@category.Name</option>
				}
			</select>
		</div>

		<div class="form-group">
			<label>
				Name
			</label>
			<input class="form-control" name="Name" value="@Model.Name" />
		</div>

		<div class="form-group">
			<label>
				Description
			</label>
			<textarea class="form-control" name="Description" placeholder="Add Description." rows="3">@Model.Description</textarea>
		</div>

	</div>
	<div class="modal-footer">
		<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
		<button class="btn btn-success" type="button" id="saveButton">
			Save
		</button>
	</div>
</form>

<script>

	$("#createForm").validate({
		errorClass: "alert alert-danger",
		errorElement: "div",
		rules: {
			Name: {
				required: true,
				minlength: 5,
				maxlength: 150
			},
			Description: {
				required: true,
				minlength: 20
			}
		},
		messages: {
			Name: {
				required: "Title is required.",
				minlength: "Minimum Length is 5.",
				maxlength: "Maximum Length is 150."
			},
			Description: {
				required: "Description is required.",
				minlength: "Minimum Length is 20.",
			}
		},
		highlight: function (element, errorClass) {
			$(element).removeClass(errorClass);
		}
	});
	$("#saveButton").click(function () {
		if ($("#createForm").valid())
		{
			$.ajax({
				url: "@Url.Action("Create", "Categories")",
				method: "post",
				data: $("#createForm").serialize()
			})
			.done(function (response) {
				$("#listingArea").html(response);
				$('#formModal').modal('toggle');
			});
		}
	});
</script>